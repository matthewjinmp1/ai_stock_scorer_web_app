# API Keys and sensitive configuration
config.py
# But allow config.example.py (template file)
!config.example.py
# But allow src/core/config.py (it's needed for deployment)
!src/core/config.py

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs & Scratchpads
*.log
notes
temp_*

# Local environment variables (keep private)
.env

# ==========================================
# PRODUCTION APP FILES (MUST BE PUSHED)
# ==========================================
!web_app/
!web_app/*.db

# ==========================================
# DEVELOPMENT & DATA (STRICT FILTERING)
# ==========================================

# 1. Ignore these entire folders
old_stuff/
development_files/
total_score/

# 2. Ignore everything in web_app_development by default
web_app_development/**

# 3. Explicitly un-ignore ONLY the JSON data needed for Glassdoor charts
!web_app_development/glassdoor/
!web_app_development/glassdoor/data/
!web_app_development/glassdoor/data/returns/
!web_app_development/glassdoor/data/returns/jsons/
!web_app_development/glassdoor/data/returns/jsons/*.json
!web_app_development/glassdoor/data/benchmark/
!web_app_development/glassdoor/data/benchmark/*.json

# 4. Keep tests but ignore their cache
!web_app_development/tests/
!web_app_development/glassdoor/tests/

# 5. Global ignores for non-production file types in dev folders
web_app_development/**/*.py
web_app_development/**/*.png
web_app_development/**/*.jsonl
web_app_development/**/*.sh
web_app_development/**/*.db
web_app_development/**/*.md

# ==========================================
# LARGE DATA FILES (NOT NEEDED FOR WEB APP)
# ==========================================

# 13F Analytics databases (not ready for production)
scripts/13f/data/
scripts/13f/data/**/*.db
data/db/filers.db

# Analysis and backtest databases
data/db/top_100_returns.db
data/db/top_ranked_returns.db
data/financials.db

# Raw data files
data/raw/
data/raw/**

# Large CSV data files (ignore by default, allow specific ones if needed)
data/**/*.csv
scripts/**/*.csv
*.csv
# Allow CSV files in web_app_development/glassdoor if needed
!web_app_development/glassdoor/data/**/*.csv
