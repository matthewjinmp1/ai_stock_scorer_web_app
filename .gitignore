# API Keys and sensitive configuration
config.py

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Ignore JSON/JSONL by default (will explicitly un-ignore needed ones below)
*.json
*.jsonl

# DEVELOPMENT & NON-ESSENTIAL
old_stuff/
development_files/
total_score/

# WEB APP CODE
!web_app/
!web_app/*.db

# GLASSDOOR PRODUCTION DATA
# To un-ignore files, we must un-ignore the parent directory path first
!web_app_development/
web_app_development/*
!web_app_development/glassdoor/
web_app_development/glassdoor/*
!web_app_development/glassdoor/data/
web_app_development/glassdoor/data/*
!web_app_development/glassdoor/data/returns/
web_app_development/glassdoor/data/returns/*
!web_app_development/glassdoor/data/returns/jsons/
!web_app_development/glassdoor/data/returns/jsons/*.json
!web_app_development/glassdoor/data/benchmark/
!web_app_development/glassdoor/data/benchmark/*.json

# TESTS & SCRIPTS
!web_app_development/tests/
!web_app_development/scripts/
